# =============================================================
#  NEPA Engineering deploy credentials  (cPanel FTP/FTPS)
#  Copy this file to  deploy.env  and fill in your details.
#  deploy.env is git-ignored — never commit real credentials.
# =============================================================

# Your cPanel FTP hostname. Usually one of:
#   ftp.nepaeng.com   |   nepaeng.com   |   the server IP from cPanel
FTP_HOST="ftp.nepaeng.com"

# cPanel FTP username (often matches your cPanel login, or an FTP account you create)
FTP_USER="your-cpanel-ftp-user"

# cPanel FTP password
FTP_PASS="your-ftp-password"

# FTP port. 21 for FTP/FTPS (explicit). Leave as 21 for most cPanel hosts.
FTP_PORT="21"

# Remote web root. On cPanel this is almost always /public_html
# (for an add-on/sub domain it may be /public_html/subfolder)
REMOTE_DIR="/public_html"
