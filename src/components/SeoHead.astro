---
import { company } from "../data/site";

interface Props {
  title: string;
  description: string;
  /** Path only, e.g. "/services/fire-protection". Canonical + OG url built from site. */
  path?: string;
  image?: string;
  type?: "website" | "article";
  /** Any JSON-LD objects to inject (already as JS objects). */
  jsonLd?: Record<string, any>[];
  noindex?: boolean;
}

const {
  title,
  description,
  path = "/",
  image = "/assets/img/hero-building.jpg",
  type = "website",
  jsonLd = [],
  noindex = false,
} = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "https://www.nepaeng.com";
const canonical = new URL(path, Astro.site ?? "https://www.nepaeng.com").toString();
const ogImage = image.startsWith("http") ? image : `${siteUrl}${image}`;

// Organisation schema is included site-wide so every page carries business identity.
const organisation = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: company.name,
  description:
    "Multi-disciplinary building services engineering consultancy providing fire, hydraulic, mechanical and electrical design across New South Wales.",
  url: `${siteUrl}/`,
  logo: `${siteUrl}/assets/img/logo.png`,
  image: `${siteUrl}/assets/img/hero-building.jpg`,
  telephone: company.phonePrimary,
  email: company.email,
  foundingDate: company.foundingYear,
  areaServed: company.areaServed,
  address: {
    "@type": "PostalAddress",
    streetAddress: company.address.street,
    addressLocality: company.address.locality,
    addressRegion: company.address.region,
    postalCode: company.address.postcode,
    addressCountry: company.address.country,
  },
  sameAs: [company.social.facebook, company.social.instagram],
};

const allSchema = [organisation, ...jsonLd];
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="theme-color" content="#f7f9fb" />

<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content={company.name} />
{noindex
  ? <meta name="robots" content="noindex, nofollow" />
  : <meta name="robots" content="index, follow, max-image-preview:large" />}
<link rel="canonical" href={canonical} />

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={company.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:locale" content="en_AU" />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<!-- Icons -->
<link rel="icon" type="image/png" href="/assets/img/logo.png" />
<link rel="apple-touch-icon" href="/assets/img/logo.png" />

<!-- Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap"
  rel="stylesheet"
/>

<!-- Structured data -->
{allSchema.map((schema) => (
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
))}
