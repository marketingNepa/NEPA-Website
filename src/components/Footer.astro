---
import { company, services } from "../data/site";
---

<footer class="footer">
  <div class="wrap">
    <div class="footer__top">
      <div>
        <img class="flogo" src="/assets/img/logo-white.png" alt={company.name} width="150" height="46" />
        <p>Multi-disciplinary building-services engineering consultancy delivering innovative, sustainable solutions across New South Wales since {company.foundingYear}.</p>
      </div>
      <nav aria-label="Services">
        <h5>Services</h5>
        {services.map((s) => (
          <a href={`/services/${s.slug}`}>{s.shortName}</a>
        ))}
        <a href="/services/cdc">Complying Development (CDC)</a>
      </nav>
      <nav aria-label="Company">
        <h5>Company</h5>
        <a href="/about">About</a>
        <a href="/services">All services</a>
        <a href="/projects">Projects</a>
        <a href="/blog">Insights</a>
        <a href="/contact">Contact</a>
      </nav>
      <div>
        <h5>Contact</h5>
        <a href={company.mapsUrl} target="_blank" rel="noopener">{company.addressSingleLine}</a>
        <a href={`tel:${company.phonePrimary}`}>{company.phonePrimaryDisplay}</a>
        <a href={`mailto:${company.email}`}>{company.email}</a>
      </div>
    </div>
    <div class="footer__bottom">
      <p class="footer__legal">
        <span>© <span id="year"></span> {company.name}. All rights reserved.</span>
        <a href="/privacy">Privacy Policy</a>
        <a href="/legal">Legal Notice</a>
        <a href="/credits">Credits</a>
      </p>
      <div class="socials">
        <a href={company.social.linkedin} target="_blank" rel="noopener" aria-label="NEPA Engineering on LinkedIn">
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="currentColor"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.22.79 24 1.77 24h20.45c.98 0 1.78-.78 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/></svg>
        </a>
        <a href={company.social.facebook} target="_blank" rel="noopener" aria-label="NEPA Engineering on Facebook">
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="currentColor"><path d="M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07c0 6.02 4.39 11.01 10.13 11.93v-8.44H7.08v-3.49h3.05V9.41c0-3.02 1.79-4.69 4.53-4.69 1.31 0 2.68.24 2.68.24v2.97h-1.51c-1.49 0-1.96.93-1.96 1.89v2.25h3.33l-.53 3.49h-2.8V24C19.61 23.08 24 18.09 24 12.07z"/></svg>
        </a>
      </div>
    </div>
  </div>
</footer>
