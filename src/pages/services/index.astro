---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CtaBand from "../../components/CtaBand.astro";
import { services } from "../../data/site";

const title = "Building Services Engineering | Services | NEPA Engineering";
const description =
  "Fire protection, hydraulic, mechanical and electrical design, plus Complying Development Certificate (CDC) support across Sydney and NSW.";

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://www.nepaeng.com/" },
    { "@type": "ListItem", position: 2, name: "Services", item: "https://www.nepaeng.com/services" },
  ],
};
---

<BaseLayout title={title} description={description} path="/services" jsonLd={[breadcrumb]}>
  <section class="hero hero--plain">
    <div class="wrap hero__inner">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span>Services</nav>
      <div class="hero__grid">
        <div>
          <p class="overline" data-reveal>What we do</p>
          <h1 data-reveal data-delay="1">Building services, <span class="em">engineered as one.</span></h1>
          <p class="lead" data-reveal data-delay="2">Four core disciplines plus Complying Development support — delivered by a single coordinated team so your project moves from concept to commissioning without the gaps between separate consultants.</p>
          <div class="hero__cta" data-reveal data-delay="3">
            <a class="btn accent" href="/contact"><span>Discuss your project</span><span class="arrow">↗</span></a>
          </div>
        </div>
        <aside class="spec-rail" data-reveal data-delay="2" aria-label="At a glance">
          <div class="srow"><span class="k">Disciplines</span><span class="v">04</span></div>
          <div class="srow"><span class="k">Established</span><span class="v">2018</span></div>
          <div class="srow"><span class="k">Coverage</span><span class="v">NSW<small>wide</small></span></div>
          <div class="srow"><span class="k">Approach</span><span class="v">Coordinated</span></div>
        </aside>
      </div>
    </div>
  </section>

  <section class="section wrap">
    <div class="svc-cards svc-cards--3">
      {services.map((s) => (
        <a class="svc-card" href={`/services/${s.slug}`} data-reveal>
          <div class="svc-card__media"><img src={s.image} alt={s.imageAlt} width="800" height="450" loading="lazy" /></div>
          <div class="svc-card__body">
            <h3>{s.shortName}</h3>
            <p>{s.excerpt}</p>
            <span class="read">Explore {s.shortName} →</span>
          </div>
        </a>
      ))}
      <a class="svc-card" href="/services/cdc" data-reveal>
        <div class="svc-card__media"><img src="/assets/img/cta-building.jpg" alt="Complying Development Certificate projects" width="800" height="450" loading="lazy" /></div>
        <div class="svc-card__body">
          <h3>Complying Development (CDC)</h3>
          <p>Fast-track approval support — coordinated building-services documentation to help your project qualify for a Complying Development Certificate.</p>
          <span class="read">Explore CDC →</span>
        </div>
      </a>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
