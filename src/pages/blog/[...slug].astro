---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CtaBand from "../../components/CtaBand.astro";
import { getCollection, type CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

type Props = { post: CollectionEntry<"blog"> };
const { post } = Astro.props;
const { Content } = await post.render();
const path = `/blog/${post.slug}`;

const fmt = (d: Date) =>
  d.toLocaleDateString("en-AU", { day: "numeric", month: "long", year: "numeric" });

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  image: `https://www.nepaeng.com${post.data.image}`,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  author: { "@type": "Organization", name: post.data.author },
  publisher: {
    "@type": "Organization",
    name: "NEPA Engineering",
    logo: { "@type": "ImageObject", url: "https://www.nepaeng.com/assets/img/logo.png" },
  },
  mainEntityOfPage: { "@type": "WebPage", "@id": `https://www.nepaeng.com${path}` },
};

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://www.nepaeng.com/" },
    { "@type": "ListItem", position: 2, name: "Insights", item: "https://www.nepaeng.com/blog" },
    { "@type": "ListItem", position: 3, name: post.data.title, item: `https://www.nepaeng.com${path}` },
  ],
};

// Keep the <title> within SEO limits: only append the brand suffix when the
// article title is short enough to leave room for it.
const brandSuffix = " | NEPA Engineering";
const metaTitle =
  post.data.title.length + brandSuffix.length <= 60
    ? post.data.title + brandSuffix
    : post.data.title;
---

<BaseLayout
  title={metaTitle}
  description={post.data.description}
  path={path}
  image={post.data.image}
  type="article"
  jsonLd={[articleSchema, breadcrumb]}
>
  <article class="section wrap">
    <div class="article">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/blog">Insights</a><span>/</span>{post.data.tag}</nav>
      <div class="meta">
        <span class="tag">{post.data.tag}</span>
        <time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
      </div>
      <h1>{post.data.title}</h1>
      <p class="lead">{post.data.description}</p>
      <img class="article__hero" src={post.data.image} alt={post.data.imageAlt} width="1200" height="600" />
      <div class="prose">
        <Content />
      </div>
      <p style="margin-top:var(--space-xl)">
        <a class="btn ghost" href="/blog"><span>← All insights</span></a>
      </p>
    </div>
  </article>

  <CtaBand heading="Talk to the engineers behind the article." buttonLabel="Get in touch" />
</BaseLayout>
