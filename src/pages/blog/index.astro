---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CtaBand from "../../components/CtaBand.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const title = "Insights | Building Services Engineering | NEPA Engineering";
const description =
  "Practical guidance on building services, compliance and design for the NSW market — fire, hydraulic, mechanical and electrical insights from NEPA Engineering.";
const path = "/blog";

const fmt = (d: Date) =>
  d.toLocaleDateString("en-AU", { day: "numeric", month: "short", year: "numeric" });

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://www.nepaeng.com/" },
    { "@type": "ListItem", position: 2, name: "Insights", item: "https://www.nepaeng.com/blog" },
  ],
};

const blogSchema = {
  "@context": "https://schema.org",
  "@type": "Blog",
  name: "NEPA Engineering Insights",
  url: "https://www.nepaeng.com/blog",
  description,
  blogPost: posts.map((p) => ({
    "@type": "BlogPosting",
    headline: p.data.title,
    description: p.data.description,
    datePublished: p.data.pubDate.toISOString(),
    url: `https://www.nepaeng.com/blog/${p.slug}`,
  })),
};
---

<BaseLayout title={title} description={description} path={path} jsonLd={[blogSchema, breadcrumb]}>
  <section class="hero">
    <div class="wrap hero__inner">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span>Insights</nav>
      <div class="hero__grid">
        <div>
          <p class="overline" data-reveal>Insights</p>
          <h1 data-reveal data-delay="1">From the <span class="em">drawing board.</span></h1>
          <p class="lead" data-reveal data-delay="2">Practical guidance on building services, compliance and design for the NSW market — written by the engineers who do the work.</p>
        </div>
        <aside class="spec-rail" data-reveal data-delay="2" aria-label="Insights overview">
          <div class="srow"><span class="k">Articles</span><span class="v">{String(posts.length).padStart(2, "0")}</span></div>
          <div class="srow"><span class="k">Topics</span><span class="v">4</span></div>
          <div class="srow"><span class="k">Focus</span><span class="v">NSW</span></div>
        </aside>
      </div>
    </div>
  </section>

  <section class="section wrap">
    <div class="posts">
      {posts.map((post, i) => (
        <a class="post" href={`/blog/${post.slug}`} data-reveal data-delay={i % 3}>
          <img src={post.data.image} alt={post.data.imageAlt} width="640" height="400" loading="lazy" />
          <div class="body">
            <span class="tag">{post.data.tag}</span>
            <h3>{post.data.title}</h3>
            <p>{post.data.description}</p>
            <span class="meta">{fmt(post.data.pubDate)}</span>
            <span class="read">Read article →</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <CtaBand heading="Have a project in mind?" buttonLabel="Get in touch" />
</BaseLayout>
