---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Image Credits | NEPA Engineering";
const description =
  "Attribution for the photography used on the NEPA Engineering website, sourced from Wikimedia Commons under open licences.";

// Photo attributions. CC BY / CC BY-SA images require credit + licence link.
const credits = [
  {
    file: "Homepage hero",
    title: "Sydney Circular Quay promenade and harbour panorama",
    author: "NEPA Engineering",
    license: "Supplied by NEPA Engineering",
    licenseUrl: "/legal",
    source: "/",
  },
  {
    file: "Residential project (mixed-use, Hurstville)",
    title: "Skyscrapers in the Sydney Central Business District, 2023",
    author: "Kgbo",
    license: "CC BY-SA 4.0",
    licenseUrl: "https://creativecommons.org/licenses/by-sa/4.0/",
    source: "https://commons.wikimedia.org/wiki/File:Skyscrapers_in_the_Sydney_Central_Business_District,_2023,_01.jpg",
  },
  {
    file: "Fire Protection",
    title: "Fire Pump Room, Brisbane, 2021",
    author: "Kgbo",
    license: "CC BY-SA 4.0",
    licenseUrl: "https://creativecommons.org/licenses/by-sa/4.0/",
    source: "https://commons.wikimedia.org/wiki/File:Fire_Pump_Room,_Brisbane,_2021.jpg",
  },
  {
    file: "Hydraulic Services",
    title: "City Underground Conduit, Milwaukee",
    author: "Aaron Volkening",
    license: "CC BY 2.0",
    licenseUrl: "https://creativecommons.org/licenses/by/2.0/",
    source: "https://www.flickr.com/photos/87297882@N03/54452685638",
  },
  {
    file: "Mechanical Services",
    title: "Rooftop air-cooled chillers / condenser plant",
    author: "NEPA Engineering",
    license: "Supplied by NEPA Engineering",
    licenseUrl: "/legal",
    source: "/",
  },
  {
    file: "Electrical Services",
    title: "Main switchboard in large commercial building, Brisbane",
    author: "Kgbo",
    license: "CC BY-SA 4.0",
    licenseUrl: "https://creativecommons.org/licenses/by-sa/4.0/",
    source: "https://commons.wikimedia.org/wiki/File:Main_switchboard_in_large_commercial_building,_Brisbane.jpg",
  },
];
---

<BaseLayout title={title} description={description} path="/credits">
  <section class="hero section--tight">
    <div class="wrap hero__inner simple">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span>Credits</nav>
      <p class="overline">Attribution</p>
      <h1>Image Credits</h1>
      <p class="lead">Photography on this site is sourced from Wikimedia Commons. Images under Creative Commons licences are credited below as required.</p>
    </div>
  </section>
  <section class="section wrap simple">
    <div class="faq">
      {credits.map((c) => (
        <div style="border-bottom:1px solid var(--line);padding:1rem 0">
          <h3 style="margin:0 0 .3rem;font-size:var(--step-1)">{c.file}</h3>
          <p style="margin:0;color:var(--muted);font-size:var(--step--1)">
            “{c.title}” by {c.author} —
            <a href={c.licenseUrl} target="_blank" rel="noopener" style="color:var(--blue)">{c.license}</a>.
            <a href={c.source} target="_blank" rel="noopener" style="color:var(--blue)">Source</a>
          </p>
        </div>
      ))}
    </div>
    <p style="color:var(--muted);font-size:var(--step--1);margin-top:var(--space-m)">Company logo and NEPA project photography remain the property of NEPA Engineering.</p>
  </section>
</BaseLayout>
